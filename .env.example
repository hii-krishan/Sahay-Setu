# Backend only. Copy to .env and replace placeholders locally; never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/sahay_setu?retryWrites=true&w=majority
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
FRONTEND_URL=http://localhost:5173
# Set to the trusted proxy hop count only when deployed behind a known proxy.
TRUST_PROXY_HOPS=0

# Frontend build-time variables (also configure these in the frontend host).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-anon-key>
VITE_API_BASE_URL=http://localhost:5000/api
